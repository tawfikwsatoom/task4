class Rectangle {
  double width;
  double height;

  Rectangle(this.width, this.height);

  Rectangle.square(double side)
      : width = side,
        height = side;

  double area() {
    return width * height;
  }
}

void main() {
  Rectangle r1 = Rectangle(5, 4);
  Rectangle r2 = Rectangle.square(6);

  print("Rectangle Area = ${r1.area()}");
  print("Square Area = ${r2.area()}");
}
